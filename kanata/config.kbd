;; Whitelist the physical keyboard so kanata doesn't grab virtual keyboards
;; (e.g. chord-daemon-virt), which would cause an emit -> re-read feedback loop.
(defcfg
  linux-dev-names-include (
    "AT Translated Set 2 keyboard"
  )
)

;; Define the keys kanata will "hook" into
(defsrc
  q w e r t y u i o p
  a s d f g h j k l ;
  c v b n m
  `
  ralt
  lsft rsft
)

;; The default behavior (Normal typing)
(deflayer default
  q w e r t y u i o p
  a s d f g h j k l ;
  c v b n m
  `
  @sym-layer
  lsft rsft
)

;; The Symbol/Number Layer
;; Activated when ralt is held. Each key that has a shift-variant is a
;; `fork` that checks (lsft rsft) at press time:
;;   * shift held  -> shift+ralt variant
;;   * shift not held -> plain ralt variant
;;
;; This per-key check means the layer transition is not tied to a specific
;; trigger key, so releasing shift while ralt is still held (or vice versa)
;; correctly returns to plain-symbols or default behavior on the next press.
;;
;; Actions for the shift-held branch are crafted for the "shift is emitted"
;; state (since the user is physically holding shift):
;;   * shifted final char (e.g. `<`) -> emit plain base key (`,`), which the
;;     OS combines with the already-held shift.
;;   * unshifted final char (e.g. `[`) -> `(unmod (lsft rsft) X)`, which
;;     releases shift for the emission and restores it afterwards.
(deflayer symbols
  S-1
  (fork S-2 (unmod (lsft rsft) \) (lsft rsft))
  (fork S-3 (unmod (lsft rsft) /) (lsft rsft))
  (fork S-4 / (lsft rsft))
  (fork S-5 (unmod (lsft rsft) `) (lsft rsft))
  (fork S-6 ` (lsft rsft))
  (fork S-7 ' (lsft rsft))
  (fork S-8 (unmod (lsft rsft) ') (lsft rsft))
  (fork S-9 ; (lsft rsft))
  (fork S-0 (unmod (lsft rsft) ;) (lsft rsft))

  1
  (fork 2 (unmod (lsft rsft) ret) (lsft rsft))
  (fork 3 (unmod (lsft rsft) [) (lsft rsft))
  (fork 4 [ (lsft rsft))
  (fork 5 , (lsft rsft))
  (fork 6 . (lsft rsft))
  (fork 7 ] (lsft rsft))
  (fork 8 (unmod (lsft rsft) ]) (lsft rsft))
  (fork 9 \ (lsft rsft))
  0

  /
  (fork . (unmod (lsft rsft) =) (lsft rsft))
  (fork b = (lsft rsft))
  (fork S-' (unmod (lsft rsft) -) (lsft rsft))
  (fork S-- (unmod (lsft rsft) ,) (lsft rsft))

  S-`

  _

  _ _
)

;; Aliases for the layer toggle.
(defalias
  sym-layer (layer-while-held symbols)
)
